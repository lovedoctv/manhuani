# Apache settings for Namecheap shared hosting (copied to the site folder on deploy).
# The site folder used below is filled in from site.config.mjs by scripts/make-deploy.mjs.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /AbroadPath/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /AbroadPath/

  # Uncomment the next 3 lines once your SSL certificate is active,
  # to send every visitor to https://
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The site used to be a manhwa site. Its old pages may still be on the server
  # (deploys copy files but never delete), so send those addresses to the home page.
  RewriteRule ^(manga|manga-genre|manga-release|chapter|title|new-titles|bookmarks|covers|page|copyright|dmca)(/.*)?$ /AbroadPath/ [R=301,L]
  RewriteRule ^blog/(welcome-to-manhuani|best-cultivation-manhua-for-beginners)/?$ /AbroadPath/blog/ [R=301,L]

  # Posts written in the blog admin (/admin/) have no folder of their own: post.php shows them.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

  # /blog/some-post  ->  /blog/some-post/  (every page is a folder with index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/ [L,R=301]

  # Never serve hidden files such as .git or .env if they ever end up here.
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # Build files in /assets/ have a content hash in their name, so they can be cached for a year.
  <FilesMatch "^.+\.[0-9A-Za-z_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
