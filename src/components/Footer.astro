---
import { url } from '../lib/data';
import site from '../../site.config.mjs';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a href={url('/')} class="logo small"><span class="logo-mark" aria-hidden="true">漫</span><span>Manhua<b>ni</b></span></a>
      <p class="muted">{site.tagline}. New chapters, series guides and reading lists, updated daily.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={url('/about/')}>About Us</a>
      <a href={url('/dmca/')}>DMCA Policy</a>
      <a href={url('/privacy/')}>Privacy Policy</a>
      <a href={url('/contact/')}>Contact Us</a>
      <a href={url('/rss.xml')}>RSS</a>
    </nav>
  </div>
  <div class="container copyright">&copy; {year} {site.name}. All series titles and artwork belong to their respective owners.</div>
</footer>
