---
import site from '../../site.config.mjs';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <nav class="utility" aria-label="Site links">
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact Us</a>
        <a href="/copyright/">Copyright Notice</a>
        <a href="/bookmarks/">Bookmarks</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch light or dark theme">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
  <div class="container header-main">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <span class="logo-mark" aria-hidden="true">漫</span>
      <span>Manhua<b>ni</b></span>
    </a>
    <form class="header-search" action="/search/" method="get" role="search">
      <input type="search" name="q" placeholder="Search manhua & manhwa..." aria-label="Search series" />
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
    </form>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="genre-nav" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
  <nav class="genre-nav" id="genre-nav" aria-label="Genres">
    <div class="container genre-nav-inner">
      <a href="/" class:list={{ active: isActive('/') }}>Home</a>
      <a href="/manga/" class:list={{ active: path === '/manga/' }}>All Series</a>
      {site.genres.map((g) => (
        <a href={`/manga-genre/${g.slug}/`} class:list={{ active: isActive(`/manga-genre/${g.slug}/`) }}>{g.name}</a>
      ))}
      <span class="mobile-only">
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact Us</a>
        <a href="/copyright/">Copyright Notice</a>
        <a href="/bookmarks/">Bookmarks</a>
      </span>
    </div>
  </nav>
</header>
