---
import { type Series, seriesUrl, chapterUrl, coverUrl, sortedChapters, formatDate } from '../lib/data';
interface Props { items: Series[] }
const { items } = Astro.props;
---
<ol class="hot-list">
  {items.map((s, i) => (
    <li>
      <span class="rank">{i + 1}</span>
      <a href={seriesUrl(s.id)} class="hot-thumb"><img src={coverUrl(s)} alt="" width="75" height="106" loading="lazy" decoding="async" /></a>
      <div>
        <a href={seriesUrl(s.id)} class="hot-title">{s.data.title}</a>
        {sortedChapters(s).slice(0, 2).map((c) => (
          <div class="hot-ch">
            <a href={chapterUrl(s.id, c.number)}>Chapter {c.number}</a>
            <time class="ago" datetime={c.date.toISOString()}>{formatDate(c.date)}</time>
          </div>
        ))}
      </div>
    </li>
  ))}
</ol>
