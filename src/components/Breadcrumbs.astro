---
import { url } from '../lib/data';
import { absoluteUrl } from '../lib/data';
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
const all = [{ name: 'Home', href: url('/') }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.name, item: absoluteUrl(it.href) })),
};
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((it, i) => (
      <li>{i < all.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
