---
import { url } from '../lib/data';
import Base from '../layouts/Base.astro';
import Sidebar from './Sidebar.astro';
import SeriesGrid from './SeriesGrid.astro';
import Pagination from './Pagination.astro';
import site from '../../site.config.mjs';
import { allSeries, popularSeries, absoluteUrl } from '../lib/data';

interface Props { page: number }
const { page } = Astro.props;
const list = await allSeries();
const total = Math.max(1, Math.ceil(list.length / site.perPage));
const items = list.slice((page - 1) * site.perPage, page * site.perPage);
const popular = page === 1 ? await popularSeries(6) : [];
const pageUrl = (n: number) => url(n === 1 ? '/' : `/page/${n}/`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: absoluteUrl('/search/') + '?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base title={page > 1 ? `Latest Updates – Page ${page}` : undefined} jsonLd={page === 1 ? jsonLd : undefined} noindex={page > 1}>
  {page === 1 && (
    <section class="container block">
      <div class="section-head"><h2>Popular Series</h2><a href={url('/manga/')}>View all</a></div>
      <SeriesGrid items={popular} variant="popular" eagerCount={6} />
    </section>
  )}

  {page === 1 && (site.social.discord || site.social.instagram) && (
    <section class="container block">
      <div class="community">
        <div>
          <h2>Join the community</h2>
          <p class="muted">Get notified about new chapters and talk about your favourite series.</p>
        </div>
        <div class="community-actions">
          {site.social.discord && <a class="btn" href={site.social.discord} rel="noopener" target="_blank">Join Discord</a>}
          {site.social.instagram && <a class="btn btn-ghost" href={site.social.instagram} rel="noopener" target="_blank">Follow Instagram</a>}
        </div>
      </div>
    </section>
  )}

  <div class="container layout block" id="latest">
    <div class="content">
      <div class="section-head"><h1 class="h2">Latest Updates</h1></div>
      <div data-live-latest={page === 1 && site.liveUpdates ? '' : undefined}>
        <SeriesGrid items={items} eagerCount={page === 1 ? 0 : 4} />
      </div>
      <Pagination current={page} total={total} url={pageUrl} />
    </div>
    <Sidebar />
  </div>

  {page === 1 && site.liveUpdates && (
    <section class="container block" data-live-new-titles data-limit="12" hidden>
      <div class="section-head"><h2>New Titles</h2><a href={url('/new-titles/')}>View all</a></div>
      <div class="series-grid"></div>
    </section>
  )}

  {page === 1 && (
    <section class="container block intro-block">
      <h2>Read manhua and manhwa updates on {site.name}</h2>
      <p class="muted">{site.description}</p>
      <p class="muted">Browse by genre, follow your favourite series with bookmarks, and check back daily for new chapters.</p>
      <div class="community-actions">
        <a class="btn" href="#latest">Latest Updates</a>
        <a class="btn btn-ghost" href={url('/manga/')}>All Series</a>
      </div>
    </section>
  )}
</Base>
