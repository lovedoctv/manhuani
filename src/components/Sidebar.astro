---
import { url } from '../lib/data';
import HotList from './HotList.astro';
import { popularSeries, allYears, yearUrl, genreUrl, genreName, allGenres } from '../lib/data';
const hot = await popularSeries(5);
const years = await allYears();
const genres = await allGenres();
---
<aside class="sidebar">
  <section class="widget">
    <h2 class="widget-title">Search Manhua &amp; Manhwa</h2>
    <form action={url('/search/')} method="get" role="search" class="widget-search">
      <input type="search" name="q" placeholder="Type a title..." aria-label="Search series" />
      <button type="submit">Search</button>
    </form>
  </section>
  <section class="widget">
    <h2 class="widget-title">Hot Series</h2>
    <HotList items={hot} />
    <a class="view-all" href={url('/manga/')}>View All</a>
  </section>
  <section class="widget">
    <h2 class="widget-title">Genres</h2>
    <div class="tag-cloud">
      {genres.map((g) => <a href={genreUrl(g)}>{genreName(g)}</a>)}
    </div>
  </section>
  <section class="widget">
    <h2 class="widget-title">Series by Year</h2>
    <div class="tag-cloud">
      {years.map((y) => <a href={yearUrl(y)}>{y}</a>)}
    </div>
  </section>
</aside>
