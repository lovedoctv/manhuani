---
import { url } from '../lib/data';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="Search" description="Search manhua and manhwa series by title, author or genre." noindex>
  <div class="container block">
    <Breadcrumbs items={[{ name: 'Search', href: url('/search/') }]} />
    <h1 class="page-title">Search</h1>
    <form class="big-search" action={url('/search/')} method="get" role="search">
      <input id="search-q" type="search" name="q" placeholder="Title, author or genre..." aria-label="Search series" autofocus />
      <button class="btn" type="submit">Search</button>
    </form>
    <p id="search-status" class="muted" aria-live="polite"></p>
    <div id="search-results" class="series-grid"></div>
  </div>
  <script>
    import '../scripts/search.ts';
  </script>
</Base>
