---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/data';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Blog" description="Manhua and manhwa reviews, reading lists, news and guides.">
  <div class="container block">
    <Breadcrumbs items={[{ name: 'Blog', href: '/blog/' }]} />
    <h1 class="page-title">Blog</h1>
    <div class="post-list">
      {posts.map((p) => (
        <article class="post-card">
          <time datetime={p.data.date.toISOString()} class="muted small">{formatDate(p.data.date)}</time>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          <p class="muted">{p.data.description}</p>
          <div class="genre-tags">{p.data.tags.map((t) => <span>{t}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</Base>
