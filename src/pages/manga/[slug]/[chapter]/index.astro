---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import {
  allSeries, type Series, type Chapter, seriesUrl, chapterUrl, chapterSlug, sortedChapters, formatDate, absoluteUrl,
  chapterSubtitle, url,
} from '../../../../lib/data';

export async function getStaticPaths() {
  const out = [];
  for (const series of await allSeries()) {
    const list = sortedChapters(series);
    list.forEach((chapter, i) => {
      out.push({
        params: { slug: series.id, chapter: `chapter-${chapterSlug(chapter.number)}` },
        props: { series, chapter, prev: list[i + 1], next: list[i - 1], all: list },
      });
    });
  }
  return out;
}
const { series, chapter, prev, next, all } = Astro.props as {
  series: Series; chapter: Chapter; prev?: Chapter; next?: Chapter; all: Chapter[];
};
const d = series.data;
const name = `${d.title} Chapter ${chapter.number}`;
const subtitle = chapterSubtitle(chapter);
const sourceName = d.source?.name;
// Page images in order. Site paths like /chapters/x/1/01.webp get the /manhuani/ folder added;
// full https:// addresses are kept as they are. Blank entries are skipped.
const pages = chapter.images.map((s) => s.trim()).filter(Boolean).map((s) => url(s));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ComicIssue',
  name,
  issueNumber: String(chapter.number),
  datePublished: chapter.date.toISOString(),
  url: absoluteUrl(chapterUrl(series.id, chapter.number)),
  isPartOf: { '@type': 'ComicSeries', name: d.title, url: absoluteUrl(seriesUrl(series.id)) },
};
---
<Base title={name} description={`Read ${name} of the ${d.type} ${d.title}. Released ${formatDate(chapter.date)}.`} type="article" jsonLd={jsonLd}>
  <div class="container reader-wrap">
    <Breadcrumbs items={[{ name: d.title, href: seriesUrl(series.id) }, { name: `Chapter ${chapter.number}`, href: chapterUrl(series.id, chapter.number) }]} />
    <h1 class="reader-title">{name}{subtitle && <small> – {subtitle}</small>}</h1>
    <p class="muted center">Released <time datetime={chapter.date.toISOString()}>{formatDate(chapter.date)}</time></p>

    <nav class="reader-nav" aria-label="Chapter navigation">
      {prev ? <a class="btn btn-ghost" href={chapterUrl(series.id, prev.number)} rel="prev">&laquo; Prev</a> : <span class="btn btn-ghost disabled">&laquo; Prev</span>}
      <select class="chapter-jump" aria-label="Jump to chapter">
        {all.map((c) => <option value={chapterUrl(series.id, c.number)} selected={c.number === chapter.number}>Chapter {c.number}</option>)}
      </select>
      {next ? <a class="btn" href={chapterUrl(series.id, next.number)} rel="next">Next &raquo;</a> : <span class="btn disabled">Next &raquo;</span>}
    </nav>

    <div class="reader">
      {pages.length > 0 ? (
        pages.map((src, i) => (
          <figure class="reader-page">
            <img src={src} alt={`${name} page ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption class="page-status">Loading page {i + 1}…</figcaption>
          </figure>
        ))
      ) : chapter.sourceUrl ? (
        <div class="reader-empty">
          <p>This chapter is published on {sourceName ?? 'another site'}.</p>
          <a class="btn" href={chapter.sourceUrl} rel="nofollow noopener" target="_blank">Read Chapter {chapter.number} {sourceName ? `on ${sourceName}` : 'at the source'}</a>
        </div>
      ) : (
        <div class="reader-empty">
          <p>The pages for this chapter haven't been added yet.</p>
          <a class="btn btn-ghost" href={seriesUrl(series.id)}>Back to {d.title}</a>
        </div>
      )}
    </div>

    <nav class="reader-nav" aria-label="Chapter navigation">
      {prev ? <a class="btn btn-ghost" href={chapterUrl(series.id, prev.number)}>&laquo; Prev</a> : <span class="btn btn-ghost disabled">&laquo; Prev</span>}
      <a class="btn btn-ghost" href={seriesUrl(series.id)}>All Chapters</a>
      {next ? <a class="btn" href={chapterUrl(series.id, next.number)}>Next &raquo;</a> : <span class="btn disabled">Next &raquo;</span>}
    </nav>
  </div>
</Base>
