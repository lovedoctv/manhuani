---
import { url } from '../lib/data';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="My Bookmarks" description="Series and chapters you have bookmarked on this device." noindex>
  <div class="container block">
    <Breadcrumbs items={[{ name: 'Bookmarks', href: url('/bookmarks/') }]} />
    <h1 class="page-title">My Bookmarks</h1>
    <p class="muted">No account needed: your bookmarks and reading history are saved in this browser on this device. Clearing your browser data removes them.</p>
    <section class="block">
      <div class="section-head"><h2>Series</h2></div>
      <div id="bookmark-results" class="series-grid"></div>
      <p id="bookmark-empty" class="empty" hidden>You haven't bookmarked any series yet. Tap + on a cover, or ☆ Bookmark on a series page.</p>
    </section>
    <section class="block cx-panel">
      <div class="section-head"><h2>Chapters</h2></div>
      <ul id="chapter-marks" class="cx-chapters"></ul>
      <p id="chapter-empty" class="empty" hidden>No bookmarked chapters yet. Tap the bookmark icon next to a chapter.</p>
    </section>
  </div>
  <script>
    import '../scripts/bookmarks-page.ts';
  </script>
</Base>
