# Dependencies and build cache
node_modules/
dist/
.astro/

# Secrets and local settings: never commit these
.env
.env.*
*.local

# Editors and OS
.DS_Store
.vscode/
.idea/
Thumbs.db

# Blog admin: the private settings and database (abroadpath_private/), and the posts, images and
# lists it writes into the site folder (live/, media/, sitemap-posts.xml), stay on the server
abroadpath_private/
*.sqlite
*.sqlite-journal

# Files cPanel's "Setup Node.js App" writes into the repo folder on the server.
# The site doesn't use Node on the server; ignoring them keeps "Deploy HEAD Commit" working.
/app.js
/stderr.log
/tmp/

# Jobs and scholarships blog (npm run build builds blog/)
/blog/dist/
/blog/.astro/
