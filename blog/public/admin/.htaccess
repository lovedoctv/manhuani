# The blog admin. Its pages are PHP; everything else here is locked down.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Only the admin page and its stylesheet and script may be opened from the web. This also locks
# any files the old manhwa dashboard left in this folder on the server.
<FilesMatch "^(?!index\.php$|admin\.css$|admin\.js$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
