---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DeadlineList from '../components/DeadlineList.astro';
import AdSlot from '../components/AdSlot.astro';
import { url, openDeadlines } from '../lib/site';
const deadlines = await openDeadlines();
---
<Base title="Scholarship and application deadlines" description="Open scholarship and application deadlines, closing soonest first, with links to each guide.">
  <div class="container narrow block">
    <Breadcrumbs items={[{ name: 'Deadlines', href: url('/deadlines/') }]} />
    <h1 class="page-title">Deadlines</h1>
    <p class="page-intro muted">Open applications, closing soonest first. Dates are taken from the official pages; always confirm on the official site before you apply.</p>
    {deadlines.length ? <DeadlineList posts={deadlines} /> : <p class="empty">No open deadlines right now. New ones are added as programmes open.</p>}
    <AdSlot name="home" />
  </div>
</Base>
